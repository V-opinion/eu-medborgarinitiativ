@'
{
  "issuer": "https://multireligionvalsystem.eu.org",
  "authorization_endpoint": "https://multireligionvalsystem.eu.org/oauth/authorize",
  "token_endpoint": "https://multireligionvalsystem.eu.org/oauth/token",
  "jwks_uri": "https://multireligionvalsystem.eu.org/.well-known/jwks.json",
  "response_types_supported": ["code"],
  "grant_types_supported": ["authorization_code", "client_credentials"],
  "token_endpoint_auth_methods_supported": ["client_secret_basic"],
  "scopes_supported": ["read", "write"],
  "code_challenge_methods_supported": ["S256"]
}
'@ | Set-Content ".well-known\oauth-authorization-server" -Encoding UTF8

  "events_supported": [
    "credential_revoked",
    "token_revoked"
  ],
  "agent_auth": {
    "skill": "https://isitagentready.com/.well-known/agent-skills/auth-md/SKILL.md",
    "register_uri": "https://multireligionvalsystem.eu.org/agent/register",
    "identity_types_supported": [
      "identity_assertion",
      "verified_email",
      "anonymous"
    ],
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag",
        "verified_email"
      ],
      "credential_types_supported": [
        "bearer"
      ],
      "claim_uri": "https://multireligionvalsystem.eu.org/agent/claim",
      "revocation_uri": "https://multireligionvalsystem.eu.org/oauth/revoke"
    },
    "verified_email": {
      "credential_types_supported": [
        "bearer"
      ],
      "claim_uri": "https://multireligionvalsystem.eu.org/agent/claim/email"
    },
    "anonymous": {
      "credential_types_supported": [
        "bearer"
      ],
      "claim_uri": "https://multireligionvalsystem.eu.org/agent/claim/anonymous"
    }
  }
}
