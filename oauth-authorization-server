{
  "issuer": "https://example.com",
  "authorization_endpoint": "https://example.com/oauth/authorize",
  "token_endpoint": "https://example.com/oauth/token",
  "jwks_uri": "https://example.com/.well-known/jwks.json",
  "registration_endpoint": "https://example.com/oauth/register",
  "scopes_supported": [
    "openid",
    "profile",
    "email",
    "agent:read",
    "agent:write"
  ],
  "response_types_supported": [
    "code"
  ],
  "grant_types_supported": [
    "authorization_code",
    "client_credentials",
    "refresh_token"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_basic",
    "client_secret_post",
    "private_key_jwt"
  ],
  "revocation_endpoint": "https://example.com/oauth/revoke",
  "revocation_endpoint_auth_methods_supported": [
    "client_secret_basic"
  ],
  "introspection_endpoint": "https://example.com/oauth/introspect",
  "code_challenge_methods_supported": [
    "S256"
  ],
  "events_supported": [
    "credential_revoked",
    "token_revoked"
  ],
  "agent_auth": {
    "skill": "https://isitagentready.com/.well-known/agent-skills/auth-md/SKILL.md",
    "register_uri": "https://example.com/agent/register",
    "identity_types_supported": [
      "identity_assertion",
      "verified_email",
      "anonymous"
    ],
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag",
        "verified_email"
      ],
      "credential_types_supported": [
        "bearer"
      ],
      "claim_uri": "https://example.com/agent/claim",
      "revocation_uri": "https://example.com/oauth/revoke"
    },
    "verified_email": {
      "credential_types_supported": [
        "bearer"
      ],
      "claim_uri": "https://example.com/agent/claim/email"
    },
    "anonymous": {
      "credential_types_supported": [
        "bearer"
      ],
      "claim_uri": "https://example.com/agent/claim/anonymous"
    }
  }
}
